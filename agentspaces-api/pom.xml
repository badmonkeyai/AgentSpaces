<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.badmonkey.agentspaces</groupId>
    <artifactId>agentspaces</artifactId>
    <version>0.2.0</version>
  </parent>

  <artifactId>agentspaces-api</artifactId>
  <name>AgentSpaces :: API</name>
  <description>
    The public API and SPI: the Space interface and template DSL, leases, entry records,
    the advertisement family, and the extension points implementations plug into.
    Applications program against this module; implementation modules stay swappable.
  </description>

  <dependencies>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-common</artifactId>
    </dependency>
    <!-- Annotations only; databind and the CBOR codec stay in agentspaces-common. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
  </dependencies>
</project>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.badmonkey.agentspaces</groupId>
    <artifactId>agentspaces</artifactId>
    <version>0.2.0</version>
  </parent>

  <artifactId>agentspaces-auth-oidc</artifactId>
  <name>AgentSpaces :: OIDC Authorization</name>
  <description>
    The OidcAuthorizer (security remediation plan §6): privileged-operation
    authorization deferred to JWT scopes minted by the organization's identity
    provider, validated with Nimbus JOSE+JWT against a cached JWKS. Optional:
    fleets on the mtls profile use the MembershipAuthorizer and never load this
    module.
  </description>

  <dependencies>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-api</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
  </dependencies>
</project>

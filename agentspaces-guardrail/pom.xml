<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ai.badmonkey.agentspaces</groupId>
    <artifactId>agentspaces</artifactId>
    <version>0.6.0</version>
  </parent>
  <artifactId>agentspaces-guardrail</artifactId>
  <name>AgentSpaces :: Guardrail</name>
  <description>
    Guardrails (ISSUE-ModelCard FR-4, FR-5; SPEC §8 aspace:cap/guardrail): the GuardrailProvider SPI,
    the Verdict a check returns, the GuardrailPolicy and GuardrailFinding records, the built-in provider
    (prompt-injection patterns, personal-data classes, term and domain lists, a schema check against a
    fragment's field list), and Guardrails.apply, the one evaluation path a gateway or a door uses, with the
    onError contract for a throwing or slow provider. Depends on nothing beyond the JDK at runtime.
  </description>
  <dependencies>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-test-support</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

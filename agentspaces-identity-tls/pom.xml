<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.badmonkey.agentspaces</groupId>
    <artifactId>agentspaces</artifactId>
    <version>0.4.0</version>
  </parent>

  <artifactId>agentspaces-identity-tls</artifactId>
  <name>AgentSpaces :: Identity TLS helpers</name>
  <description>
    The pieces every attesting transport binding shares (spec §5.6): one key
    manager that serves the channel credential, one trust manager that defers
    the trust decision to attestation, and one attestation call over a
    presented chain. The tls binding uses them today; the dtls binding and the
    planned wss binding use them too, so a fix lands in one place.
  </description>

  <dependencies>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-common</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-test-support</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

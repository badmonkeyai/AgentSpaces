<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.badmonkey.agentspaces</groupId>
    <artifactId>agentspaces</artifactId>
    <version>0.2.0</version>
  </parent>

  <artifactId>agentspaces-space</artifactId>
  <name>AgentSpaces :: Space (Layer 3)</name>
  <description>
    Layer 3 of the spec: the AgentSpace tuple space. Ships LocalSpace, a complete
    single-JVM implementation of the Space API with leases and notifications, plus
    the delta-CRDT core (OR-Set entry state, LWW lease registers) on which the
    replicated space grows.
  </description>

  <dependencies>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-api</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-common</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-peering</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-test-support</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

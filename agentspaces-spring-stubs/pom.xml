<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.badmonkey.agentspaces</groupId>
    <artifactId>agentspaces</artifactId>
    <version>0.2.0</version>
  </parent>

  <artifactId>agentspaces-spring-stubs</artifactId>
  <name>AgentSpaces :: Spring API Stubs (build-time only)</name>
  <description>
    A minimal compile surface with Spring Framework and Spring Boot fully
    qualified names, letting the autoconfigure modules build in environments
    without Maven Central access. NEVER ships to applications and MUST only be
    referenced in provided scope: at runtime the real Spring classes with the
    same names take over, since annotation and interface references resolve by
    name. See docs/BUILD-ENVIRONMENTS.md.
  </description>

  <properties>
    <!-- This module contains org.springframework.* compile stubs and must
         NEVER be published to any repository: deploy, Central publishing,
         signing, and the publication jars are all switched off. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <skipPublishing>true</skipPublishing>
    <gpg.skip>true</gpg.skip>
    <maven.source.skip>true</maven.source.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
  </properties>
</project>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ai.badmonkey.agentspaces</groupId>
    <artifactId>agentspaces</artifactId>
    <version>0.6.0</version>
  </parent>
  <artifactId>agentspaces-store</artifactId>
  <name>AgentSpaces :: Content Store Peer (Layer 4)</name>
  <description>
    The content store peer (srad/agentspaces-pdt2.md §3.2, group S): any peer becomes a store that
    advertises a content-store asset card, takes StorePin entries from the content space the way a
    connector takes a DataQuery, fetches, pins, and holds the root, completes the pin with a
    StoreReceipt, keeps leases and a ledger, answers possession challenges, and holds sealed trees
    blind. It opens no socket and adds no peer role.
  </description>
  <dependencies>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-api</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-common</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-agent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-content</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-pdt</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The card, the rows, and the invokes ride the connector SDK (P2-S-01, P2-S-09, P2-S-13). -->
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-connect-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-planner</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-test-support</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.badmonkey.agentspaces</groupId>
    <artifactId>agentspaces</artifactId>
    <version>0.4.0</version>
  </parent>

  <artifactId>agentspaces-transport-webrtc</artifactId>
  <name>AgentSpaces :: WebRTC Transport</name>
  <description>
    The webrtc binding of the Transport SPI (spec §5.5, SRAD srad/agentspaces-js.md
    §3.4, §3.5): one RTCPeerConnection per peer connection with one ordered,
    reliable data channel (aspace/1), signalling over the aspace:cap/rtc-signal
    capability pipe, and attestation by the DTLS fingerprint each side signs into
    its signal. The engine sits behind the DataChannelEngine seam; the first engine
    is libdatachannel-java, whose native library this module alone carries.
  </description>

  <properties>
    <!--
      libdatachannel-java publishes its native library per platform under a
      classifier (aarch64 and x86_64 for Linux, macos-arm64 and macos-x86_64,
      windows-x86_64). The default suits the Linux CI; the OS-activated profiles
      below select the others, and -Dwebrtc.native.classifier=... overrides for
      anything else. Every test that opens a channel assumes the engine loads,
      so an unsupported platform skips with the engine's own reason.
    -->
    <webrtc.native.classifier>x86_64</webrtc.native.classifier>
    <libdatachannel-java.version>0.24.1.1</libdatachannel-java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-api</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-common</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-identity-tls</artifactId>
    </dependency>
    <!-- The signalling capability hands sessions to the node's group runtime
         (JS-N-02), so peering is compile scope here where the HTTP module
         keeps it for tests alone. -->
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-peering</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>tel.schich</groupId>
      <artifactId>libdatachannel-java</artifactId>
      <version>${libdatachannel-java.version}</version>
    </dependency>
    <dependency>
      <groupId>tel.schich</groupId>
      <artifactId>libdatachannel-java</artifactId>
      <version>${libdatachannel-java.version}</version>
      <classifier>${webrtc.native.classifier}</classifier>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-space</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-test-support</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The two-browser proof (JS-W-12) seeds the browsers from a Java RELAY
         node over the ws binding, the one carrier a browser can dial. -->
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-transport-http</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- The engine loads its native library; JDK 24+ warns without this. -->
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>webrtc-native-linux-aarch64</id>
      <activation>
        <os>
          <family>unix</family>
          <name>Linux</name>
          <arch>aarch64</arch>
        </os>
      </activation>
      <properties>
        <webrtc.native.classifier>aarch64</webrtc.native.classifier>
      </properties>
    </profile>
    <profile>
      <id>webrtc-native-osx-aarch64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>aarch64</arch>
        </os>
      </activation>
      <properties>
        <webrtc.native.classifier>macos-arm64</webrtc.native.classifier>
      </properties>
    </profile>
    <profile>
      <id>webrtc-native-osx-x86_64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>x86_64</arch>
        </os>
      </activation>
      <properties>
        <webrtc.native.classifier>macos-x86_64</webrtc.native.classifier>
      </properties>
    </profile>
    <profile>
      <id>webrtc-native-windows-x86_64</id>
      <activation>
        <os>
          <family>windows</family>
          <arch>amd64</arch>
        </os>
      </activation>
      <properties>
        <webrtc.native.classifier>windows-x86_64</webrtc.native.classifier>
      </properties>
    </profile>
  </profiles>
</project>

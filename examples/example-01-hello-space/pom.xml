<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.badmonkey.agentspaces</groupId>
    <artifactId>agentspaces-examples</artifactId>
    <version>0.2.0</version>
  </parent>

  <artifactId>example-01-hello-space</artifactId>
  <name>AgentSpaces :: Example 01 :: Hello Space</name>
  <description>
    One process, one LocalSpace: write a task entry, take it, complete it with a
    result, and watch a lapsed take lease make the task reappear.
  </description>

  <dependencies>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-space</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-test-support</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>ai.badmonkey.agentspaces.examples.hello.HelloSpace</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

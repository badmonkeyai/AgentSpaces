<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.badmonkey.agentspaces</groupId>
    <artifactId>agentspaces-examples</artifactId>
    <version>0.2.0</version>
  </parent>

  <artifactId>example-02-research-fleet</artifactId>
  <name>AgentSpaces :: Example 02 :: Research Fleet</name>
  <description>
    The replicated-worker demo over the full Layer 0-4 stack on TCP: a coordinator
    writes research tasks into a replicated space, workers on separate peers drain
    them, one worker dies mid-task, and its task reappears and completes elsewhere.
  </description>

  <dependencies>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-space</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-peering</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-discovery</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>ai.badmonkey.agentspaces.examples.fleet.ResearchFleet</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

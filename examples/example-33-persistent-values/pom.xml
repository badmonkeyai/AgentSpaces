<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ai.badmonkey.agentspaces</groupId>
    <artifactId>agentspaces-examples</artifactId>
    <version>0.6.0</version>
  </parent>
  <artifactId>example-33-persistent-values</artifactId>
  <name>AgentSpaces Example 33 :: Persistent Values</name>
  <description>
    Example 33: values that change across a fleet (srad/agentspaces-pdt.md §7.3).
    A curator holds a map of 10,000 facts and a blob of table rows as refs, three
    analysts revise facts concurrently, the curator appends to and inserts into the
    blob, an analyst dies during a fetch, a reduce accumulator grows by delta in an
    opted-in space, and a Python reader derefs the same roots over real TCP.
  </description>
  <dependencies>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-agent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-pdt</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-content</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-capabilities</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-peering</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-space</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-identity</artifactId>
    </dependency>
    <!-- The dtls binding of PdtBindingsTest (PD-Q-TST-03). -->
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-transport-dtls</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>ai.badmonkey.agentspaces.examples.pdt.PersistentValuesFleet</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.badmonkey.agentspaces</groupId>
    <artifactId>agentspaces</artifactId>
    <version>0.2.0</version>
  </parent>

  <artifactId>agentspaces-examples</artifactId>
  <packaging>pom</packaging>
  <name>AgentSpaces :: Examples</name>
  <description>Graduated examples demonstrating each layer of AgentSpaces features.</description>

  <properties>
    <!-- Examples are demos; the framework modules carry the coverage burden. -->
    <jacoco.line.minimum>0.00</jacoco.line.minimum>

    <!-- Not a library: never published to Maven Central. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <skipPublishing>true</skipPublishing>
    <gpg.skip>true</gpg.skip>
    <maven.source.skip>true</maven.source.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
  </properties>

  <modules>
    <module>example-01-hello-space</module>
    <module>example-02-research-fleet</module>
    <module>example-03-discovery-cards</module>
    <module>example-04-auction</module>
    <module>example-05-quorum</module>
    <module>example-06-wan-rendezvous</module>
    <module>example-07-a2a-fleet</module>
    <module>example-08-intake-fleet</module>
    <module>example-09-fleet-console</module>
    <module>example-10-data-fleet</module>
    <module>example-11-quickstart</module>
    <module>example-12-exactly-once-desk</module>
    <module>example-13-signed-agents</module>
    <module>example-14-gossip-learning</module>
  </modules>
</project>

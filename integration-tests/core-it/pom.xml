<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.badmonkey.agentspaces</groupId>
    <artifactId>agentspaces</artifactId>
    <version>0.7.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>agentspaces-core-it</artifactId>
  <name>AgentSpaces :: Core Integration Tests</name>
  <description>
    Reactor-wide checks of the core (srad/agentspaces-event-loop.md): IdleCostIT, the idle-cost harness that runs
    groups of real peers in separate JVMs over TCP and records their idle CPU, wakes, lateness, keepalive frames,
    detection and newcomer times in the measurements store; TtlRegisterTest; and ThreadPolicyTest, the thread policy
    over every core main class. Test only: never deployed, never published. IdleCostIT
    runs only when asked (-Didle.cost=true), one shape per run (owner rule 2026-11-11, single runs).
  </description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <skipPublishing>true</skipPublishing>
    <gpg.skip>true</gpg.skip>
    <maven.source.skip>true</maven.source.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <!-- A measurement harness: the product carries the coverage burden. -->
    <jacoco.line.minimum>0.00</jacoco.line.minimum>
  </properties>

  <dependencies>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-peering</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-space</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-capabilities</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-content</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-pdt</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-agent</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- TtlRegisterTest reads the TTL defaults of these modules (srad/agentspaces-event-loop.md EL-E-02). -->
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-connect-core</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-identity</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-store</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-discovery</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-spring-boot-autoconfigure</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- ThreadPolicyTest reads every core module's main classes (srad/agentspaces-event-loop.md §3.8, EL-X-06). -->
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-common</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-transport-dtls</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-transport-webrtc</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>1.4.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-test-measure</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- IdleCostIT is an IT by name (it forks JVMs and takes minutes); surefire runs it when -Didle.cost=true,
           and it reports itself disabled otherwise. The idle.* properties pass through to the test JVM. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
            <include>**/*IT.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
